{
	"name": "web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply inkwell --local",
		"db:migrate:remote": "wrangler d1 migrations apply inkwell --remote"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@codemirror/commands": "^6.10.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@glyphdown/core": "workspace:*",
		"@glyphdown/editor": "workspace:*",
		"@glyphdown/protocol": "workspace:*",
		"@glyphdown/sync": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "^0.8.0",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.132.0",
		"@tanstack/react-router-devtools": "^1.132.0",
		"@tanstack/react-router-ssr-query": "^1.132.0",
		"@tanstack/react-start": "~1.168.0",
		"@tanstack/router-plugin": "^1.132.0",
		"better-auth": "^1.6.14",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^0.545.0",
		"partyserver": "^0.5.6",
		"posthog-js": "^1.382.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"y-partyserver": "^2.2.0",
		"yjs": "^13.6.31"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "^0.4.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"better-sqlite3": "^12.10.0",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^28.1.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.5",
		"wrangler": "^4.98.0"
	}
}